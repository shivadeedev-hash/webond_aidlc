# Copy to deploy/aws/params.dev.env or params.prod.env (those names are gitignored)
# and edit. KEY=VALUE, no spaces around "=". Lines starting with # are ignored.
# Empty or missing keys use the template defaults.

# ---- Custom domain (REQUIRED for prod) ----
# Public host name of the site.
#DomainName=app.example.com
# Route 53 hosted zone that contains DomainName (the stack then creates the DNS records).
# Leave it out if your DNS is elsewhere and create the records yourself (see the stack outputs).
#HostedZoneId=Z0123456789ABCDEFGHIJ
# ACM certificate in the SAME region as the stack, covering origin.<DomainName>
# (used between CloudFront and the load balancer).
#AlbCertificateArn=arn:aws:acm:ap-southeast-1:111111111111:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ACM certificate in us-east-1 covering DomainName (CloudFront only accepts us-east-1).
#CloudFrontCertificateArn=arn:aws:acm:us-east-1:111111111111:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---- E-mail (REQUIRED for prod: account verification and password reset) ----
# Free option: Gmail SMTP with an app password (about 500 e-mails/day).
# Store the app password first (SSM standard parameters are free):
#   read -rs SMTP_PW   # paste the app password (not echoed, not saved in shell history)
#   aws ssm put-parameter --name /webond/prod/smtp-password --type SecureString --value "$SMTP_PW"; unset SMTP_PW
#SmtpHost=smtp.gmail.com
#SmtpPort=465
#SmtpUsername=your.name@gmail.com
#SmtpPasswordParameter=/webond/prod/smtp-password
#SmtpFrom=WeBond <your.name@gmail.com>
# ---- Operations ----
# E-mail address for CloudWatch alarms (you must confirm the subscription e-mail).
#AlertEmail=ops@example.com
# Number of API tasks after a deploy (default: 1 for dev, 2 for prod).
#ServiceCount=2
#MaxCount=4

# ---- Sizing ----
#DbInstanceClass=db.t4g.micro
#TaskCpu=256
#TaskMemory=512
#LogRetentionDays=90
#CloudFrontPriceClass=PriceClass_200
