# WeBond — root environment sample (no secrets here)
# Copy to .env and fill real values, or run ./scripts/gen-env.sh to create it with
# random secrets. .env is gitignored.

# --- Backend (Go API) ---
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# MySQL DSN used by the API (docker-compose provides the mysql service).
# Alternative for managed databases: leave DATABASE_URL empty and set
# DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD (the DSN is built for you);
# add DB_TLS_CA_FILE=/path/to/ca-bundle.pem to verify the server certificate.
DATABASE_URL=webond:webond@tcp(mysql:3306)/webond?parseTime=true&loc=Asia%2FBangkok

# JWT secrets — random values; in production they must be >= 32 characters and
# must not contain the "change-me" placeholder or the API refuses to start.
JWT_ACCESS_SECRET=change-me-dev
JWT_REFRESH_SECRET=change-me-dev

# Graceful shutdown window (ms)
SHUTDOWN_TIMEOUT_MS=30000

# Apply pending DB migrations on boot (default: true outside production,
# false in production, where `webond migrate` runs as a one-off task).
MIGRATE_ON_BOOT=true
# Load the demo dataset on boot (default: true outside production, never in production).
SEED_ON_BOOT=true
# Browser origins allowed to call the API (comma separated). Default outside
# production: http://localhost:5173. Leave empty in production (same origin).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- E-mail (verification, password reset, notifications) ---
# docker compose default: the local Mailpit catcher (free). Every e-mail appears
# at http://localhost:8025 and nothing leaves this machine. Leave these
# commented to keep that default.
#
# To deliver to real inboxes for free with Gmail (about 500 e-mails/day):
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an app password: https://myaccount.google.com/apppasswords
#   3. Uncomment and fill in (the app password is a secret, never commit it):
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465
#SMTP_USERNAME=your.name@gmail.com
#SMTP_PASSWORD=abcdefghijklmnop   # the 16-letter app password, without spaces
# Optional. Gmail sends as SMTP_USERNAME anyway. SMTP_TLS: tls (465), starttls (587), none (local only).
#SMTP_FROM=WeBond <your.name@gmail.com>
#SMTP_TLS=tls
# Web address shown in notification e-mails (default http://localhost:5173). Verification and reset use 6-digit codes.
#APP_PUBLIC_URL=http://localhost:5173

# --- MySQL (docker-compose) ---
MYSQL_DATABASE=webond
MYSQL_USER=webond
MYSQL_PASSWORD=webond
MYSQL_ROOT_PASSWORD=webond-root

# --- Frontend (Vite) ---
# Used by `npm run dev` on the host only:
#   mock = UI on local JSON fixtures (Node only); api = call the Go API.
# The web container started by docker compose is always built in api mode.
VITE_DATA_SOURCE=mock
VITE_API_URL=http://localhost:8080/api
# URL the browser uses to reach the API from the compose web container.
PUBLIC_API_URL=http://localhost:8080/api
