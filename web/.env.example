# Frontend data layer: mock = local JSON fixtures (Node only), api = call the Go API
#
# Default is `mock` so the UI runs on Node alone. To exercise the real backend,
# set VITE_DATA_SOURCE=api (the http.ts services in src/services/*/ take over,
# no page changes needed) and point VITE_API_URL at the running API.
# The docker-compose `web` service already runs with VITE_DATA_SOURCE=api.
VITE_DATA_SOURCE=mock
VITE_API_URL=http://localhost:8080/api
